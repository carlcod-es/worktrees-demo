@{
    var products = Model.Children()!.Where(c => c.ContentType.Alias == "product").ToList();
}
<header class="page-header">
    <h1>@Model.Value("title")</h1>
    <p>@Model.Value("intro")</p>
</header>
<section class="product-grid">
    @foreach (var p in products)
    {
        @await Html.PartialAsync("productCard", p)
    }
</section>