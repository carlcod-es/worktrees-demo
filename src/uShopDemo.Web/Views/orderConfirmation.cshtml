@{
    var home = Model.AncestorOrSelf(1)!;
}
<h1>@Model.Value("title")</h1>
<div data-order>
    <div data-order-view aria-live="polite"></div>
    <template data-order-pending>
        <p class="confirmation">Order <strong class="order-number" data-field="orderNumber"></strong> is being processed. This page updates automatically.</p>
    </template>
    <template data-order-confirmed>
        <p class="confirmation">Order <strong class="order-number" data-field="orderNumber"></strong> is placed.</p>
        <p><i>This is a demo: nothing is charged or shipped.</i></p>
        <ul class="order-lines" data-order-lines></ul>
        <template data-order-line>
            <li><span><span data-field="quantity"></span> × <span data-field="name"></span></span><span data-field="lineTotal"></span></li>
        </template>
        <p class="total"><span>Total</span><span data-field="total"></span></p>
        <p>Ship to <span data-field="name"></span>, <span data-field="address"></span></p>
        <p>Ordered <span data-field="orderedUtc"></span></p>
        <p><a class="button" href="@home.Url()">Continue shopping</a></p>
    </template>
    <template data-order-rejected>
        <p class="confirmation">Order <strong class="order-number" data-field="orderNumber"></strong> could not be placed: <span data-field="reason"></span></p>
        <p><a class="button" href="@home.Url()">Back to the shop</a></p>
    </template>
    <template data-order-notfound>
        <p>Order not found.</p>
        <p><a href="@home.Url()">Back to the shop</a></p>
    </template>
</div>