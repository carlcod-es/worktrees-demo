@{
    var home = Model.AncestorOrSelf(1)!;
    var confirmation = home.Children()!.FirstOrDefault(c => c.ContentType.Alias == "orderConfirmation");
}
<h1>@Model.Value("title")</h1>
<div data-cart>
    <div data-cart-empty-target></div>
    <div class="checkout" data-cart-requires-items hidden>
        <form class="checkout-form" data-checkout data-confirmation-url="@confirmation?.Url()" novalidate>
            <label for="name">Name</label>
            <input id="name" name="name" aria-describedby="name-error" autocomplete="name">
            <span class="field-error" id="name-error" data-error-for="name"></span>

            <label for="email">Email</label>
            <input id="email" name="email" type="email" aria-describedby="email-error" autocomplete="email">
            <span class="field-error" id="email-error" data-error-for="email"></span>

            <label for="address">Address</label>
            <textarea id="address" name="address" rows="3" aria-describedby="address-error" autocomplete="street-address"></textarea>
            <span class="field-error" id="address-error" data-error-for="address"></span>

            <label for="cardNumber">Card number <small>(demo: type anything, nothing is charged or stored)</small></label>
            <input id="cardNumber" name="cardNumber" aria-describedby="cardNumber-error" autocomplete="off">
            <span class="field-error" id="cardNumber-error" data-error-for="cardNumber"></span>

            <button type="submit" class="button">Place order · <span data-cart-total></span></button>
        </form>
        <aside class="order-summary">
            <h2>Order summary</h2>
            <ul data-cart-lines></ul>
            <p class="total"><span>Total</span><span data-cart-total></span></p>
        </aside>
    </div>
    <template data-cart-line>
        <li><span><span data-field="quantity"></span> × <span data-field="name"></span></span><span data-field="lineTotal"></span></li>
    </template>
    <template data-cart-empty>
        <p class="empty">Your cart is empty. <a href="@home.Url()">Continue shopping</a></p>
    </template>
</div>