@using System.Globalization
@using Umbraco.Cms.Core.Models.Blocks
@{
    var category = Model.Parent()!;
    var productTitle = Model.Value<string>("title");
    var description = Model.Value<BlockListModel>("description");
    var gallery = (Model.Value<IEnumerable<IPublishedContent>>("images") ?? Enumerable.Empty<IPublishedContent>())
        .Select(m => (Url: m.Url(), AltText: m.Value<string>("altText")))
        .Where(m => !string.IsNullOrEmpty(m.Url))
        .Select((m, i) => (m.Url, Alt: string.IsNullOrWhiteSpace(m.AltText) ? $"{productTitle}, image {i + 1}" : m.AltText))
        .ToList();
}
<p class="breadcrumb"><a href="@category.Url()">&larr; @category.Name</a></p>
<article class="product-detail">
    @if (gallery.Count > 0)
    {
        <div class="product-gallery" data-gallery>
            <img class="product-image" data-gallery-main src="@gallery[0].Url" alt="@gallery[0].Alt">
            <ul class="product-thumbs" aria-label="Product images">
                @for (var i = 0; i < gallery.Count; i++)
                {
                    <li><a data-gallery-thumb href="@gallery[i].Url" data-alt="@gallery[i].Alt" aria-current="@(i == 0 ? "true" : null)"><img src="@gallery[i].Url" alt="@gallery[i].Alt"></a></li>
                }
            </ul>
        </div>
    }
    <div class="product-info">
        <h1>@Model.Value("title")</h1>
        <p class="sku">SKU @Model.Value("sku")</p>
        <p class="price price-large">@Money.Format(Model.Value<decimal>("price"))</p>
        <p class="summary">@Model.Value("summary")</p>
        <form class="add-form" data-cart-add data-product-key="@Model.Key" data-product-name="@Model.Value("title")" data-product-sku="@Model.Value("sku")" data-product-price="@(Model.Value<decimal>("price").ToString(CultureInfo.InvariantCulture))">
            <label for="quantity">Quantity</label>
            <input id="quantity" name="quantity" type="number" min="1" max="99" step="1" value="1" required>
            <button type="submit" class="button">Add to cart</button>
        </form>
        @if (description?.Any() == true)
        {
            <div class="description">@await Html.GetBlockListHtmlAsync(description)</div>
        }
    </div>
</article>