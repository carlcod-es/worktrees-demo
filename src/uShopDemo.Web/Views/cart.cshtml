@{
    var home = Model.AncestorOrSelf(1)!;
    var checkout = home.Children()!.FirstOrDefault(c => c.ContentType.Alias == "checkout");
}
<h1>@Model.Value("title")</h1>
<div data-cart>
    <table class="cart-table">
        <thead data-cart-requires-items hidden>
            <tr><th>Product</th><th class="num">Price</th><th>Quantity</th><th class="num">Total</th><th></th></tr>
        </thead>
        <tbody data-cart-lines></tbody>
        <tfoot data-cart-requires-items hidden>
            <tr><th colspan="3">Total</th><th class="num" data-cart-total></th><th></th></tr>
        </tfoot>
    </table>
    @if (checkout is not null)
    {
        <p class="actions" data-cart-requires-items hidden><a class="button" href="@checkout.Url()">Checkout</a></p>
    }
    <template data-cart-line>
        <tr>
            <td><span data-field="name"></span> <span class="sku" data-field="sku"></span></td>
            <td class="num" data-field="unitPrice"></td>
            <td>
                <form class="inline-form" data-line-form>
                    <input name="quantity" type="number" min="0" max="99" step="1" required data-line-quantity>
                    <button type="submit" class="button-link" data-line-update>Update</button>
                </form>
            </td>
            <td class="num" data-field="lineTotal"></td>
            <td><button type="button" class="button-link" data-line-remove>Remove</button></td>
        </tr>
    </template>
    <template data-cart-empty>
        <tr><td colspan="5"><p class="empty">Your cart is empty. <a href="@home.Url()">Continue shopping</a></p></td></tr>
    </template>
</div>