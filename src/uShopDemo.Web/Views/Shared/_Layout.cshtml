@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    var home = Model.AncestorOrSelf(1)!;
    var categories = home.Children()!.Where(c => c.ContentType.Alias == "category").ToList();
    var cartPage = home.Children()!.FirstOrDefault(c => c.ContentType.Alias == "cart");
    var section = Model.AncestorOrSelf(2);
    var logoUrl = home.Value<IPublishedContent>("logo")?.Url();
    var branch = Config["USHOP_BRANCH"] ?? "unknown";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(Model.Value<string>("title") ?? Model.Name) · @home.Value("siteTitle")</title>
    <meta name="ushop-api" content="@Config["USHOP_API_URL"]">
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true">
    <script type="module" src="/js/cart.js" asp-append-version="true"></script>
    <script type="module" src="/js/gallery.js" asp-append-version="true"></script>
    <script type="module" src="/js/nav.js" asp-append-version="true"></script>
</head>
<body>
    <header class="site-header" data-nav>
        <div class="wrap header-row">
            @if (!string.IsNullOrEmpty(logoUrl))
            {
                <a class="brand" href="@home.Url()"><img src="@logoUrl" alt="@home.Value("siteTitle")"></a>
            }
            else
            {
                <a class="brand" href="@home.Url()">@home.Value("siteTitle")</a>
            }
            <button type="button" class="nav-toggle" data-nav-toggle hidden aria-expanded="false" aria-controls="site-nav"><span aria-hidden="true">☰</span> Menu</button>
            <nav class="site-nav" id="site-nav" data-nav-menu aria-label="Categories">
                @foreach (var c in categories)
                {
                    <a href="@c.Url()" class="@(section?.Id == c.Id ? "active" : null)">@c.Name</a>
                }
            </nav>
            @if (cartPage is not null)
            {
                <a class="cart-link" href="@cartPage.Url()" aria-label="Cart, 0 items">Cart <span class="cart-count" data-cart-count>0</span></a>
            }
        </div>
    </header>
    <main class="wrap site-main">
        <p data-cart-status role="status" aria-live="polite" class="cart-status"></p>
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="wrap">@home.Value("siteTitle") · @home.Value("tagline") · Layout: baseline</div>
    </footer>
    <div class="branch-badge" title="git branch">@branch</div>
</body>
</html>
