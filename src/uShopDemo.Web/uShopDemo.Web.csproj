    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>uShopDemo.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="18.3.0" />
    <PackageReference Include="Umbraco.Cms.Persistence.EFCore" Version="18.3.0" />
