{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": { "outputTemplate": "{Level:u3} {SourceContext}: {Message:lj}{NewLine}{Exception}" }
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "00000000-0000-0000-0000-000000000001",
        "SanitizeTinyMce": true
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true
      },
      "Unattended": {
        "InstallUnattended": true,
        "UnattendedUserName": "Demo Admin",
        "UnattendedUserEmail": "admin@demo.local",
        "UnattendedUserPassword": "Demo-Password-1234!"
      },
      "ModelsBuilder": { "ModelsMode": "Nothing" },
      "WebRouting": { "ApplicationUrlDetection": "FirstRequest" },
      "Hosting": {
        "Debug": true
      },
      "Imaging": {
        "HMACSecretKey": "chC23xSKl9r2XB6GAprI9ZIcL\u002BB7zCVLU4DMAX3Cp1ZUxlICm/fakV1\u002Bd2oYIRLRIozvqnxsDXmkSxHZZ2JozA=="
      }
    }
  },
  "uSync": {
    "Settings": {
      "ImportOnFirstBoot": true,
      "FirstBootGroup": "All"
    }
  }
}