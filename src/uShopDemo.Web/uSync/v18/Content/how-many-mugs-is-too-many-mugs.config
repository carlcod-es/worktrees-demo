  <Properties>
    <mainContent>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "7e5b24ac-fc8e-4b56-93b7-9820810ef7d7",
      "key": "cfece21d-c81a-4794-a4b3-10613be77d9c",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch2\u003EThe cupboard problem\u003C/h2\u003E\u003Cp\u003EThere is a point at which a shelf stops holding mugs and starts holding a personality. Perry reached that point somewhere around mug number twenty-three, a chipped stoneware number from a pottery fair that nobody remembers attending.\u003C/p\u003E\u003Cp\u003EThe question of how many mugs is too many has no scientific answer, but there is a useful rule: if you can no longer open the cupboard without using a hand to catch the avalanche, you have crossed a line, and the next avalanche will probably land handle first.\u003C/p\u003E\u003Ch3\u003EWhy we keep them\u003C/h3\u003E\u003Cp\u003EMugs carry stories. One came free with a magazine. One was a gift from a relative who thought it was funny. One is perfect, with a thick lip, a comfortable handle and exactly the right weight, and it sits at the back in case of emergency, which is a ridiculous way to treat the best thing you own.\u003C/p\u003E\u003Cp\u003EThe answer, for Perry, is a firm and flexible number: the count of mugs you actually use in a month, plus two for guests, plus one for sentiment. Anything beyond that goes to a charity shop, where it will make a stranger exactly as happy and equally confused.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "f7647714-71d7-47fb-a92f-89ed359c535a",
      "key": "43ff5dd0-6320-4adc-a29a-053ec0647aff",
      "values": [
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "A mug audit in four questions"
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Do you use it at least once a month?\nDoes the handle fit your fingers?\nCan you name where it came from?\nWould you be sad to see it go?"
        }
      ]
    }
  ],
  "settingsData": [],
