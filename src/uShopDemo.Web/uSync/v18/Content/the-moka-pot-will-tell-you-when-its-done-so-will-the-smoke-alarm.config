  <Properties>
    <mainContent>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "7e5b24ac-fc8e-4b56-93b7-9820810ef7d7",
      "key": "084ef515-00a9-4c65-a7b6-a68b39a85652",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch2\u003EListening for the gurgle\u003C/h2\u003E\u003Cp\u003EThe moka pot is a lovely thing: a little aluminium tower that makes strong coffee on the stove and asks nothing in return except attention. Perry has found this to be the sticking point. Attention is the one thing a kitchen at 7am does not provide.\u003C/p\u003E\u003Cp\u003EThe pot has a clear way of telling you it is finished. It gurgles, spits and hisses in a rising scale, a bit like a kettle having a difficult conversation. If you hear that, take it off the heat. If you hear a different, higher noise from the hallway, you have waited too long and the smoke alarm is now the pot\u0027s assistant.\u003C/p\u003E\u003Ch3\u003EA rescue plan\u003C/h3\u003E\u003Cp\u003EStart with medium heat, not high. Keep the lid open so you can watch the coffee rise. When it turns pale and blonde at the end of the stream, run the base under cold water to stop the brew. Do not wander off to check your messages. Nothing in your messages is as urgent as a pot with a dry bottom.\u003C/p\u003E\u003Cp\u003EBurnt coffee is an education, but the lesson is not a pleasant one, and the smell lingers in curtains for a week. Perry keeps a tea towel by the hob as a flag of surrender and a reminder to stay put.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "f7647714-71d7-47fb-a92f-89ed359c535a",
      "key": "0eac9c29-0905-4322-a029-fa7894c3ec23",
      "values": [
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Moka pot warning signs"
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "A gurgle that turns into a roar\nCoffee stream that goes pale and thin\nA smell like burnt toast and regret\nNeighbours knocking with concern"
        }
      ]
    },
    {
      "contentTypeKey": "8f6abe09-cffc-4fe0-a645-b265fdc8010b",
      "key": "2316622c-dc26-4fd4-aee7-d40a256e45a0",
      "values": [
        {
          "alias": "quote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "It was only ninety seconds. The alarm disagreed."
        },
        {
          "alias": "attribution",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ottoline Brackenwick, serial stovetop optimist"
        }
      ]
    }
  ],
