  <Properties>
    <mainContent>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "7e5b24ac-fc8e-4b56-93b7-9820810ef7d7",
      "key": "a1ad5b3a-7f43-4d12-aa7f-c16f326e3ead",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch2\u003EReading the back of the bag\u003C/h2\u003E\u003Cp\u003ECoffee bags promise a lot. Blackcurrant, jasmine, toasted almond, a hint of rain on warm stone. Perry has bought bags that listed seven flavours and delivered one, and that one was called coffee. This is not a complaint. It is a request for a translator.\u003C/p\u003E\u003Cp\u003ETasting notes are a kind of poetry, and like all poetry they work best when you let them be suggestive. The roaster is describing an impression, not a recipe. Nobody has ever found an actual plum in the cup, and if you did, you would want to speak to someone about it.\u003C/p\u003E\u003Ch3\u003EA short phrasebook\u003C/h3\u003E\u003Cp\u003EBright usually means sharp, as in lemon. Balanced means nothing went wrong. Complex means the roaster could not decide. Chocolatey means it is dark, and it will taste of the toast on the top of a cake. Clean means you could drink it without noticing, which is high praise in a kitchen full of opinions.\u003C/p\u003E\u003Cp\u003EThe practical advice is to taste slowly, one sip at a time, with something plain nearby. Write down what you think rather than what the bag says. After a few weeks of notes, you will find your own vocabulary, which is more reliable than the bag, and a good deal funnier.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "f7647714-71d7-47fb-a92f-89ed359c535a",
      "key": "9e3f56bd-7253-4f2f-af50-5d53f495ebfd",
      "values": [
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Common notes and their meanings"
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Bright: sharp and a bit lemony\nBalanced: nothing went wrong\nComplex: the roaster shrugged\nJuicy: please do not squeeze it"
        }
      ]
    },
    {
      "contentTypeKey": "8f6abe09-cffc-4fe0-a645-b265fdc8010b",
      "key": "b2c8263f-55a4-4a5a-a996-7e148b6bc4ce",
      "values": [
        {
          "alias": "quote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "I tasted tropical fruit. My neighbour tasted a damp towel. We were both correct."
        },
        {
          "alias": "attribution",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Cornelius Pennywhistle, tasting-flight enthusiast"
        }
      ]
    }
  ],
  "settingsData": [],
