  <Properties>
    <mainContent>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "7e5b24ac-fc8e-4b56-93b7-9820810ef7d7",
      "key": "19c8e3ae-c046-4922-a566-d5f64f34688c",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch2\u003EThe last sip problem\u003C/h2\u003E\u003Cp\u003EEveryone who has ever drunk from a French press knows the moment. The cup is nearly empty, the coffee has gone thick and silty, and there is a decision to make about the final mouthful. Perry makes it every time, and every time it is the wrong one.\u003C/p\u003E\u003Cp\u003EBut the sludge deserves some defence. Those fine particles are the reason the cup has such a full, heavy body, the sort that paper filters strip away. A press brew is a rich, oily and honest drink, and the grit is simply the cost of admission.\u003C/p\u003E\u003Ch3\u003EManaging the silt\u003C/h3\u003E\u003Cp\u003EIf you want less of it, grind coarser, pour slowly and let the plunger rest on the surface for a minute before you push it down. Decant the coffee into another vessel straight away, because leaving it on the grounds will turn it bitter and gritty at once.\u003C/p\u003E\u003Cp\u003EIf you want more of it, do the opposite and call it rustic. Perry stands somewhere in the middle, a little defensive, with a spoon for the last inch of the cup. Nobody has ever been given a medal for drinking the final sip, but the right to describe it as texture is surely a prize.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "8f6abe09-cffc-4fe0-a645-b265fdc8010b",
      "key": "11a0858d-7f16-467d-a2f2-0b7d4a74dde4",
      "values": [
        {
          "alias": "quote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The bottom of the cup is where the coffee keeps its opinions."
        },
        {
          "alias": "attribution",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Barnaby Thistledown, plunger evangelist"
        }
      ]
    }
  ],
