  <Properties>
    <mainContent>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "7e5b24ac-fc8e-4b56-93b7-9820810ef7d7",
      "key": "3a072f21-6579-416e-aabc-fa442450be81",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch2\u003EThe elegant spout\u003C/h2\u003E\u003Cp\u003EPick up a gooseneck kettle and your posture changes. Your wrist straightens, your elbow lifts and a faint, serious expression arrives on your face. You have become a person who pours with intent. Nobody has checked whether the water lands where you meant it to.\u003C/p\u003E\u003Cp\u003EThe long, thin spout is there for a reason. It slows the flow and gives you a steady, narrow stream, which means you can place the water on the coffee bed in small circles rather than a single heavy splash. That control is real, and it does improve the brew, which is why the confidence is only partly unearned.\u003C/p\u003E\u003Ch3\u003EThe learning curve\u003C/h3\u003E\u003Cp\u003EFor the first week, the water will dribble down the underside of the spout and onto the counter. This is called a learning experience. Tilt in one smooth motion, not in jerks, and the stream will settle down into something respectable.\u003C/p\u003E\u003Cp\u003EPerry keeps a cloth beside the kettle for the first fortnight of every new one, and recommends the same to anyone who has just spent a lot of money on a fancy spout. Eventually the motion becomes automatic, and you start pouring like a swan with somewhere to be.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "8f6abe09-cffc-4fe0-a645-b265fdc8010b",
      "key": "763a13ad-c58e-4278-a79e-177db295cab1",
      "values": [
        {
          "alias": "quote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "I do not know what I am doing, but I am doing it beautifully."
        },
        {
          "alias": "attribution",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Philomena Ashgrove, gooseneck owner"
        }
      ]
    }
  ],
