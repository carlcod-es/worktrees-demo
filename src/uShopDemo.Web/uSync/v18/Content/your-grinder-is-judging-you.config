  <Properties>
    <mainContent>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "7e5b24ac-fc8e-4b56-93b7-9820810ef7d7",
      "key": "37d9e4b0-0d0d-4aae-a03b-202d85582a65",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch2\u003EThe silent audit\u003C/h2\u003E\u003Cp\u003EEvery morning, your grinder watches you shuffle across the kitchen, tip in a scoop of beans you bought three weeks ago, and twist the dial to a setting you picked by feel. It says nothing. This is how you know it is judging you. A loud grinder is just a machine. A quiet one with a hopper full of your poor decisions is a critic.\u003C/p\u003E\u003Cp\u003EPerry has spent years in close company with grinders and can report that the verdicts arrive in a consistent order. First comes the dial. Second comes the dose, which you eyeballed. Third comes the tap on the side of the hopper, which the grinder takes as an admission of guilt.\u003C/p\u003E\u003Ch3\u003EWhat the burrs have seen\u003C/h3\u003E\u003Cp\u003EBurrs are patient. They have ground oily dark roast, pale and woody leftovers, and one regrettable attempt at spice blends. They remember all of it, in the sense that the fragments are still lodged in the corners. If your grinder rattles, that is not wear. That is commentary.\u003C/p\u003E\u003Cp\u003EThe fix is not complicated, and nobody will grade it. Weigh the beans, clean the machine now and then, and stop apologising to it out loud. The apologies only make the silence worse, and the neighbours have started to wonder who you are talking to at six in the morning.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "f7647714-71d7-47fb-a92f-89ed359c535a",
      "key": "f46bf66b-bd8b-4977-a754-ec78b2e5a55b",
      "values": [
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Signs your grinder disapproves"
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "It stalls on the one morning you are late\nA suspicious pile of fines by the chute\nGrinding noises that sound like a sigh\nCoffee that tastes faintly of last week"
        }
      ]
    },
    {
      "contentTypeKey": "8f6abe09-cffc-4fe0-a645-b265fdc8010b",
      "key": "4a6cb844-7c6b-41e5-ade3-c95eefe59257",
      "values": [
        {
          "alias": "quote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "A grinder never complains. It just waits for you to taste the result."
        },
        {
          "alias": "attribution",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Marguerite Oakhollow, retired barista"
        }
      ]
    }
  ],
  "settingsData": [],
  "expose": [
