  <Properties>
    <mainContent>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "7e5b24ac-fc8e-4b56-93b7-9820810ef7d7",
      "key": "3cc79c33-95d5-4a2e-abde-5065a74c43d4",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch2\u003EHabitat and behaviour\u003C/h2\u003E\u003Cp\u003EThe coffee bore is found in offices, dinner parties and queues, usually just after someone says the word espresso. It can be recognised by a sudden lowering of the voice, as if disclosing a secret, followed by the phrase: well, actually, it depends on the origin.\u003C/p\u003E\u003Cp\u003EPerry can speak about this with authority, having been a coffee bore for most of a decade. The species has several subtypes, and most people carry at least one of them around without realising.\u003C/p\u003E\u003Ch3\u003ESpotting the subtypes\u003C/h3\u003E\u003Cp\u003EThe Gram Counter measures everything and shares the numbers unprompted. The Origin Historian knows which hillside grew your beans and how the farmer felt about it. The Machine Collector has a spare machine in the hallway and a reason for each one.\u003C/p\u003E\u003Cp\u003EEscape is possible but requires timing. Agree warmly, say that you have to refill your cup, and leave while the bore is still taking a breath. Never ask a follow-up question. A follow-up question is the coffee bore equivalent of feeding a seagull.\u003C/p\u003E\u003Cp\u003EIf you recognise yourself in this guide, take comfort. Most of the bores are lovely company, provided you do not mention water temperature.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "f7647714-71d7-47fb-a92f-89ed359c535a",
      "key": "edfcf352-1ef9-48ea-aeca-5a332d349150",
      "values": [
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Field marks of the coffee bore"
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Carries a scale to restaurants\nSays mouthfeel without blushing\nOwns three kettles, uses one\nBrings a personal dripper on holiday"
        }
      ]
    }
  ],
