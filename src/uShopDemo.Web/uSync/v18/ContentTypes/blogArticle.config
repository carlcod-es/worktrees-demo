<ContentType Key="bba03d99-77df-4b06-b536-bc511300c03a" Alias="blogArticle" Level="1">
  <Info>
    <Name>Blog article</Name>
    <Icon>icon-article</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[A blog post. Has its own page and a card on the blog listing.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <ListView>00000000-0000-0000-0000-000000000000</ListView>
    <Variations>Nothing</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Compositions />
    <DefaultTemplate>blogArticle</DefaultTemplate>
    <AllowedTemplates>
      <Template Key="d478f72c-0cca-445a-b5a8-248f06e8de9d">blogArticle</Template>
    </AllowedTemplates>
    <AllowedInLibrary>false</AllowedInLibrary>
  </Info>
  <Structure />
